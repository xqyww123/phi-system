# -*- shell-script -*- :mode=shellscript:

# additional symbols used by phi-System; symbols-words is generated by
# fonts/build_word_glyphs.py, one entry per keyword rendered as a single glyph
ISABELLE_SYMBOLS="$ISABELLE_SYMBOLS:$COMPONENT/symbols:$COMPONENT/symbols-words"

# font providing the glyphs of those symbols
isabelle_fonts "$COMPONENT/fonts/PhiSymbols.ttf"

PHI_SYSTEM_HOME="$COMPONENT"

# A word glyph sits on a private-use code point, which means nothing outside jEdit, so
# copying one out gives other applications a blank.  jedit/phi_word_clipboard.bsh fixes
# that in both directions, but jEdit runs startup scripts only from its own settings
# directory -- so link it there, and put it back if it goes missing.
if [ -n "$JEDIT_SETTINGS" ] && [ ! -e "$JEDIT_SETTINGS/startup/phi_word_clipboard.bsh" ]
then
  # a convenience, so never let it interfere with a batch run
  mkdir -p "$JEDIT_SETTINGS/startup" 2>/dev/null && \
    ln -sf "$COMPONENT/jedit/phi_word_clipboard.bsh" "$JEDIT_SETTINGS/startup/" 2>/dev/null
fi
