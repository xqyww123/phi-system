// Properties phi_word_clipboard.bsh must hold, checked against the generated table.
//
// The two halves of the word-glyph feature are generated apart: fonts/build_word_glyphs.py
// writes word-clipboard-text and symbols-words, and this directory's script reads the first.
// Nothing makes them agree except that they are regenerated together, so this test exists to
// catch the drift.  It exercises the real interpreter and the real committed table -- run it
// after any change to either half.  See ../fonts/WORD_GLYPHS.md, "Copying a word out of
// jEdit", and jedit/WORD_BOUNDARY_PLAN.md for why the boundary marker is there.
//
// Every name here carries the phi_ prefix, locals of helper methods included.  That is not
// tidiness: in BeanShell a method assigning a bare name walks the namespace chain and writes
// through to an existing binding, so a helper's `i` becomes the caller's loop counter.  A
// test written the other way does not fail when a check fires -- it loops printing the same
// line for ever, which is what this file did until it was measured.
//
// Run it with jedit/run_word_clipboard_test.sh, which supplies the interpreter, a display,
// a timeout and the checks on this script's own output.

import java.awt.datatransfer.DataFlavor;
import java.awt.datatransfer.StringSelection;
import org.gjt.sp.jedit.EBComponent;
import org.gjt.sp.jedit.EBMessage;
import org.gjt.sp.jedit.EditBus;
import org.gjt.sp.jedit.Registers;
import org.gjt.sp.jedit.datatransfer.JEditDataFlavor;
import org.gjt.sp.jedit.datatransfer.RichTextTransferable;
import org.gjt.sp.jedit.datatransfer.TransferHandler;
import org.gjt.sp.jedit.gui.HistoryTextArea;
import org.gjt.sp.jedit.gui.HistoryTextField;
import org.gjt.sp.jedit.buffer.JEditBuffer;
import org.gjt.sp.jedit.msg.EditPaneUpdate;
import org.gjt.sp.jedit.syntax.SyntaxStyle;
import org.gjt.sp.jedit.syntax.Token;
import org.gjt.sp.jedit.textarea.JEditTextArea;
import org.gjt.sp.jedit.textarea.Selection;
import org.gjt.sp.jedit.textarea.TextAreaTransferHandler;
import org.gjt.sp.util.Log;

// Registered before the script is loaded, because loading it installs the AWT listener
// and every field built after that asks for the family.  Under Isabelle this ordering is
// automatic -- Isabelle_Fonts.init runs a hundred lines before jEdit starts, and
// etc/settings already lists this file -- but this interpreter is bare jedit.jar.
java.awt.GraphicsEnvironment.getLocalGraphicsEnvironment().registerFont(
    java.awt.Font.createFont(java.awt.Font.TRUETYPE_FONT,
        new java.io.File(System.getenv("PHI_SYSTEM_HOME") + "/fonts/PhiSymbols.ttf")));

source(System.getenv("PHI_SYSTEM_HOME") + "/jedit/phi_word_clipboard.bsh");

phi_tbl = phi_word_table();
phi_failures = new int[1];              // an array, so no helper needs to write through
phi_marker = new String(Character.toChars(0x2060));   // never a literal: it is invisible

phi_hex(phi_s) {
    StringBuffer phi_b = new StringBuffer();
    for (int phi_i = 0; phi_i < phi_s.length(); ) {
        int phi_c = phi_s.codePointAt(phi_i);
        phi_b.append(" U+" + Integer.toHexString(phi_c).toUpperCase());
        phi_i += Character.charCount(phi_c);
    }
    return phi_b.toString().trim();
}

phi_bad(phi_what) {                     // a failure with nothing useful to compare against
    System.out.println("FAIL " + phi_what);
    phi_failures[0] = phi_failures[0] + 1;
}

phi_saw(phi_what, phi_got) {            // a predicate failed: only what was seen is news
    System.out.println("FAIL " + phi_what + "\n  saw  " + phi_hex(phi_got));
    phi_failures[0] = phi_failures[0] + 1;
}

phi_check(phi_what, phi_got, phi_want) {
    if (phi_got.equals(phi_want)) return void;
    System.out.println("FAIL " + phi_what + "\n  got  " + phi_hex(phi_got)
                       + "\n  want " + phi_hex(phi_want));
    phi_failures[0] = phi_failures[0] + 1;
}

phi_bold(phi_w) {                       // mathematical bold small letters
    StringBuffer phi_b = new StringBuffer();
    for (int phi_i = 0; phi_i < phi_w.length(); phi_i++)
        phi_b.appendCodePoint(0x1D41A + (int) phi_w.charAt(phi_i) - (int) 'a');
    return phi_b.toString();
}

// Word glyphs are named, not spelled: the letters are mathematical and cannot be typed
// here.  ../symbols-words maps an Isabelle symbol name to the code point, and is generated
// by the same script as the table, so reading it is also how the two are compared below.
phi_names = new java.util.HashMap();
phi_symbols = new java.io.File(System.getenv("PHI_SYSTEM_HOME"), "symbols-words");
if (!phi_symbols.isFile()) {
    phi_bad("../symbols-words is missing; the test cannot name a glyph");
} else {
    phi_line_pat = java.util.regex.Pattern.compile(
        "^\\\\<([^>]+)>\\s+code:\\s*(0x[0-9A-Fa-f]+)");
    for (phi_line : java.nio.file.Files.readAllLines(phi_symbols.toPath())) {
        phi_line_m = phi_line_pat.matcher(phi_line);
        if (phi_line_m.find())
            phi_names.put(phi_line_m.group(1),
                          new Integer(Integer.decode(phi_line_m.group(2)).intValue()));
    }
}

phi_glyph(phi_name) {
    Integer phi_code = phi_names.get(phi_name);
    if (phi_code == null) {
        phi_bad("no glyph named " + phi_name + "; update this test");
        return "";
    }
    return new String(Character.toChars(phi_code.intValue()));
}

phi_expand = phi_tbl.get("expand");
phi_n = 0;

// 1. the two generated halves describe the same words.  This is the drift the header
//    promises to catch: a word present in symbols-words but missing from the table renders
//    in the editor and then leaves jEdit as a raw private-use code point.
phi_missing = new java.util.ArrayList(phi_names.values());
phi_missing.removeAll(phi_expand.keySet());
phi_extra = new java.util.ArrayList(phi_expand.keySet());
phi_extra.removeAll(phi_names.values());
if (!phi_missing.isEmpty() || !phi_extra.isEmpty())
    phi_bad("symbols-words and word-clipboard-text disagree: " + phi_missing.size()
            + " named but not in the table, " + phi_extra.size()
            + " in the table but unnamed -- regenerate both with build_word_glyphs.py");

// 2. every entry folds to its glyph and expands back -- the round trip, over all of them,
//    and a lone glyph gets no boundary marker
for (phi_code : phi_expand.keySet()) {
    phi_g = new String(Character.toChars(phi_code.intValue()));
    phi_letters = phi_expand.get(phi_code);
    phi_check("fold " + phi_letters, phi_word_fold(phi_tbl, phi_letters), phi_g);
    phi_check("expand " + phi_hex(phi_g), phi_word_expand(phi_tbl, phi_g), phi_letters);
    if (phi_word_expand(phi_tbl, phi_g).indexOf(phi_marker) >= 0)
        phi_saw("a lone glyph got a boundary marker", phi_word_expand(phi_tbl, phi_g));
    phi_n = phi_n + 1;
}

// 3. two glyphs written directly against each other survive the round trip.  This is what
//    the boundary marker is for: without it 49 of these pairs come back wrong, one of them
//    -- \<or'>\<else> -> \<orelse> -- as a different word with no sign anything happened.
phi_codes = new java.util.ArrayList(phi_expand.keySet());
phi_pairs = 0;
phi_broken = 0;
for (phi_a : phi_codes) {
    phi_ga = new String(Character.toChars(phi_a.intValue()));
    for (phi_b : phi_codes) {
        phi_s = phi_ga + new String(Character.toChars(phi_b.intValue()));
        phi_pairs = phi_pairs + 1;
        phi_r = phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_s));
        if (!phi_r.equals(phi_s)) {
            phi_broken = phi_broken + 1;
            if (phi_broken <= 3) phi_check("pair " + phi_hex(phi_s), phi_r, phi_s);
        }
    }
}
if (phi_broken > 3) phi_bad((phi_broken - 3) + " further broken pairs of " + phi_pairs);

// 4. the two three-glyph failures, the longest a minimal failure can be
phi_tri1 = phi_glyph("prem") + phi_glyph("is") + phi_glyph("else");
phi_tri2 = phi_glyph("prem") + phi_glyph("is") + phi_glyph("entry");
phi_check("three glyphs, prem is else",
          phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_tri1)), phi_tri1);
phi_check("three glyphs, prem is entry",
          phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_tri2)), phi_tri2);

// 5. the ambiguity is removed, not resolved against the single word: \<orelse> copied on
//    its own must still come back as \<orelse>
phi_orelse = phi_glyph("orelse");
phi_check("orelse alone", phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_orelse)),
          phi_orelse);

// 6. bold letters on BOTH sides of an adjacent pair: neither expansion folds, so this is
//    the one shape where a conditional marker strip would leave an invisible character in
//    the buffer.  The strip is unconditional, so nothing is left.
phi_zzz = phi_bold("zzz");
phi_both = phi_zzz + phi_glyph("has") + phi_glyph("has") + phi_zzz;
phi_got = phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_both));
if (phi_got.indexOf(phi_marker) >= 0)
    phi_saw("a boundary marker was left in the buffer", phi_got);
phi_has_letters = phi_expand.get(new Integer(phi_glyph("has").codePointAt(0)));
phi_check("bold on both sides comes back as letters", phi_got,
          phi_zzz + phi_has_letters + phi_has_letters + phi_zzz);

// 7. a boundary marker arriving from anywhere is removed
phi_check("a pasted boundary marker is removed",
          phi_word_fold(phi_tbl, "a" + phi_marker + "b"), "ab");

// 8. ASCII a word does not claim is carried over, so a word keeps folding when it is
//    written against punctuation.  This is what the periods in `w.r.t.` broke.
phi_pending = phi_expand.get(new Integer(phi_glyph("pending").codePointAt(0)));
phi_pg = phi_glyph("pending");
phi_check("word then full stop", phi_word_fold(phi_tbl, phi_pending + "."), phi_pg + ".");
phi_check("word in parentheses", phi_word_fold(phi_tbl, "(" + phi_pending + ")"),
          "(" + phi_pg + ")");
phi_check("word then newline", phi_word_fold(phi_tbl, phi_pending + "\n"), phi_pg + "\n");

// 9. a mathematical letter no word claims abandons the whole run -- somebody else's bold
//    text in a comment must come back exactly as it went out
phi_check("not a word, untouched", phi_word_fold(phi_tbl, phi_zzz), phi_zzz);
phi_check("not a word, with a word beside it", phi_word_fold(phi_tbl, phi_zzz + phi_pending),
          phi_zzz + phi_pending);

// 10. plain ASCII is not the clipboard's business
phi_check("plain ASCII untouched", phi_word_fold(phi_tbl, "keep_me and int and bool."),
          "keep_me and int and bool.");

// 11. every alternative in the folding pattern is quoted.  `w.r.t.` carries two regex
//     metacharacters, so without Pattern.quote it becomes a pattern whose `.` matches
//     anything -- and folding an innocent bold word then throws inside the paste wrapper,
//     where the catch turns it into a silently unconverted paste.
phi_check("a table word is matched literally, not as a pattern",
          phi_word_fold(phi_tbl, phi_bold("warmth")), phi_bold("warmth"));

// 12. shapes WORD_BOUNDARY_PLAN.md does not repair.  Pinned so that a later widening of
//     the insertion rule is a decision somebody took, not an accident.
phi_size_then = phi_glyph("size") + "_" + phi_glyph("then'");
phi_got = phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_size_then));
for (phi_i = 0; phi_i < phi_got.length(); phi_i++)
    if (phi_expand.containsKey(new Integer(phi_got.charAt(phi_i)))) {
        phi_saw("size _ then' should carry no glyph", phi_got);
        break;
    }
phi_change_d = phi_word_expand(phi_tbl, phi_glyph("change")) + phi_bold("d");
phi_check("change against a user's bold d becomes changed",
          phi_word_fold(phi_tbl, phi_change_d), phi_glyph("changed"));

// 13. the shipped behaviour this rewrite changed on purpose: a glyph written against a
//     mathematical character no word uses.  What counts as one run is now the whole
//     mathematical alphanumeric block, not the letters the table happens to spell with, so
//     the run is abandoned where it used to fold -- and, because `.` and `_` are
//     run-forming, that reaches across them too.  See "A deliberate widening".
phi_pending_q = phi_word_expand(phi_tbl, phi_glyph("pending")) + phi_bold("q");
phi_check("pending against a bold q stays letters", phi_word_fold(phi_tbl, phi_pending_q),
          phi_pending_q);
phi_pending_dot_q = phi_word_expand(phi_tbl, phi_glyph("pending")) + "." + phi_bold("q");
phi_check("pending, a full stop and a bold q stays letters",
          phi_word_fold(phi_tbl, phi_pending_dot_q), phi_pending_dot_q);

// 14. the null guards
if (phi_word_expand(phi_tbl, null) != null) phi_bad("expand null");
if (phi_word_fold(phi_tbl, null) != null) phi_bad("fold null");

// 15. every word must be exactly one run, asked of the pattern itself rather than by
//     restating the convention.  A word spelled with anything the run class does not cover
//     -- a digit, a hyphen, a mathematical character outside the block -- would simply stop
//     folding.  If this fires, widen phi_run_class and say so in ../fonts/WORD_GLYPHS.md.
for (phi_key : phi_tbl.get("keys"))
    if (!phi_tbl.get("run_pat").matcher(phi_key).matches())
        phi_saw("this word is not one run, so it will not fold", phi_key);

// 16. the two compiled classes, pinned directly.  Neither shows up in any output
//     comparison -- widening either leaves every byte of every result unchanged and only
//     costs time -- so nothing but an assertion catches it.
if (phi_tbl.get("run_pat").matcher("._.").find())
    phi_bad("punctuation alone counts as a run; a run must hold a mathematical letter, or "
            + "every full stop in ordinary source costs a trip through the interpreter");
if (!phi_tbl.get("run_pat").matcher("." + phi_bold("a") + "_").find())
    phi_bad("a mathematical letter with punctuation around it is not recognised as one run");
phi_last_code = 0;
for (phi_code : phi_expand.keySet())
    if (phi_code.intValue() > phi_last_code) phi_last_code = phi_code.intValue();
phi_beyond = new String(Character.toChars(phi_last_code + 1));
if (phi_tbl.get("glyph_pat").matcher(phi_beyond).find())
    phi_bad("the glyph class reaches past the table's own last code point");
phi_check("a private-use character past the table is left alone",
          phi_word_expand(phi_tbl, phi_beyond + phi_beyond), phi_beyond + phi_beyond);

// 16b. a code point inside the span that is no longer a word -- the state that deleting a
//      word from words.txt leaves behind, since the generator keeps survivors by name and
//      retires the code point rather than reusing it.  Expansion must look the word up
//      before it marks a boundary, or a WORD JOINER ends up glued to a raw private-use
//      character.  Built here by holing a copy of the table, patterns and all.
phi_holed = new java.util.HashMap(phi_tbl);
phi_holed_expand = new java.util.HashMap(phi_expand);
phi_retired = new Integer(phi_glyph("pending").codePointAt(0));
phi_holed_expand.remove(phi_retired);
phi_holed.put("expand", phi_holed_expand);
phi_live = phi_glyph("has");
phi_out2 = phi_word_expand(phi_holed, phi_pg + phi_live);
if (phi_out2.indexOf(phi_marker) >= 0)
    phi_saw("a boundary marker was marked beside a retired code point", phi_out2);
phi_out2 = phi_word_expand(phi_holed, phi_live + phi_pg);
if (phi_out2.indexOf(phi_marker) >= 0)
    phi_saw("a boundary marker was marked beside a retired code point", phi_out2);

// 17. the two objects phi_word_install actually puts in place, driven end to end.  Without
//     this, everything in that function is covered only by "the script loaded" -- and the
//     feature inverted, folding on copy and expanding on paste, still passes every check
//     above.
phi_out = TransferHandler.getInstance().getTransferable(null, phi_pg)
              .getTransferData(DataFlavor.stringFlavor);
phi_check("the copy hook expands", phi_out, phi_pending);
java.awt.Toolkit.getDefaultToolkit().getSystemClipboard()
    .setContents(new StringSelection(phi_out), null);
phi_check("the paste hook folds what the copy hook produced",
          Registers.getRegister('$').getTransferable()
              .getTransferData(DataFlavor.stringFlavor), phi_pg);

// 18. pasting into jEdit's own text input fields.  These are plain Swing text components
//     whose stock handler reads the plain-text flavor, so without the wrapper the field
//     receives letters while the buffer holds the glyph and the search matches nothing.
phi_area = new HistoryTextArea("phi-test");
phi_stock = phi_area.getTransferHandler();
if (!phi_wrap_field(phi_area)) phi_bad("the field was not wrapped");
if (phi_wrap_field(phi_area)) phi_bad("wrapping is not idempotent");
if (phi_stock == null || phi_stock.getClass().getName().indexOf("TextTransferHandler") < 0)
    phi_bad("the wrapped handler was not Swing's stock one: " + phi_stock);

phi_paste(phi_field, phi_transferable) {
    phi_field.setText("");
    phi_field.getTransferHandler().importData(phi_field, phi_transferable);
    return phi_field.getText();
}

// a. text copied inside jEdit carries the glyphs under jEdit's own flavor: taken as is, so
//    even a shape folding cannot repair arrives exactly
phi_check("the rich flavor is taken as is",
          phi_paste(phi_area, new RichTextTransferable(phi_size_then, "text")),
          phi_size_then);

// b. both flavors present, as a real jEdit copy leaves them: the rich one wins
phi_both_flavors = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() {
        return new DataFlavor[] { JEditDataFlavor.jEditRichTextDataFlavor,
                                  DataFlavor.stringFlavor };
    }
    public boolean isDataFlavorSupported(DataFlavor f) {
        return JEditDataFlavor.jEditRichTextDataFlavor.equals(f)
               || DataFlavor.stringFlavor.equals(f);
    }
    public Object getTransferData(DataFlavor f) {
        if (JEditDataFlavor.jEditRichTextDataFlavor.equals(f))
            return new org.gjt.sp.jedit.datatransfer.JEditRichText(phi_size_then, "text");
        return phi_word_expand(phi_tbl, phi_size_then);
    }
};
phi_check("the rich flavor wins over the plain one",
          phi_paste(phi_area, phi_both_flavors), phi_size_then);

// c. text from outside jEdit has only the plain flavor, and is folded
phi_plain = new StringSelection(phi_pending);
phi_check("letters from another application fold", phi_paste(phi_area, phi_plain), phi_pg);

// d. ordinary text is not the clipboard's business here either
phi_check("ordinary text is untouched",
          phi_paste(phi_area, new StringSelection("/home/user/a_file.thy")),
          "/home/user/a_file.thy");

// e. a transferable that throws must not propagate out of importData
phi_thrower = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() {
        return new DataFlavor[] { DataFlavor.stringFlavor };
    }
    public boolean isDataFlavorSupported(DataFlavor f) { return true; }
    public Object getTransferData(DataFlavor f) { throw new java.io.IOException("no data"); }
};
try { phi_area.getTransferHandler().importData(phi_area, phi_thrower); }
catch (Exception e) { phi_bad("a throwing transferable escaped importData: " + e); }

// f. everything that is not the incoming text goes straight through to the inner handler
phi_seen = new java.util.HashMap();
phi_recorder = new javax.swing.TransferHandler() {
    public boolean canImport(javax.swing.JComponent c, DataFlavor[] f) {
        phi_seen.put("canImport", Boolean.TRUE); return true;
    }
    public int getSourceActions(javax.swing.JComponent c) {
        phi_seen.put("getSourceActions", Boolean.TRUE); return 3;
    }
    public void exportToClipboard(javax.swing.JComponent c,
                                  java.awt.datatransfer.Clipboard cb, int a) {
        phi_seen.put("exportToClipboard", Boolean.TRUE);
    }
};
phi_outer = phi_field_handler(phi_recorder);
phi_outer.canImport(phi_area, new DataFlavor[0]);
if (phi_outer.getSourceActions(phi_area) != 3) phi_bad("getSourceActions was not forwarded");
phi_outer.exportToClipboard(phi_area, new java.awt.datatransfer.Clipboard("phi-test"), 1);
for (phi_what : new String[] { "canImport", "getSourceActions", "exportToClipboard" })
    if (!phi_seen.containsKey(phi_what))
        phi_bad(phi_what + " did not reach the inner handler");

// g. the fields are built lazily inside dialogs, so they are found by a global AWT listener
//    rather than by name.  Both shapes the search widgets use: a field added straight to a
//    panel, and an area that arrives inside a JScrollPane.
phi_panel = new javax.swing.JPanel();
phi_bar_field = new HistoryTextField("phi-test");
phi_panel.add(phi_bar_field);
if (phi_bar_field.getClientProperty("phi_word_wrapped") == null)
    phi_bad("the listener missed a field added to a panel");
phi_dialog_area = new HistoryTextArea("phi-test");
phi_panel.add(new javax.swing.JScrollPane(phi_dialog_area));
if (phi_dialog_area.getClientProperty("phi_word_wrapped") == null)
    phi_bad("the listener missed an area inside a scroll pane");
phi_check("a field found by the listener folds too",
          phi_paste(phi_bar_field, phi_plain), phi_pg);

// 19. the script's function locals are declared with a type, so no global of the same name
//     can reach into them.  Untyped, an assignment inside a method writes through to any
//     such global -- and two of the script's own functions share the name `phi_m`, so one
//     clobbers the other's matcher mid-call.  None of that shows up in ordinary output.
//     The primary-selection wrapper's own locals are checked the same way in 22, where the
//     stand-in register that lets its methods be exercised at all is built.
phi_m = "planted";
phi_buf = "planted";
phi_letters = "planted";
phi_pos = "planted";
phi_check("a hostile global does not disturb the round trip",
          phi_word_fold(phi_tbl, phi_word_expand(phi_tbl, phi_pg + phi_pg)), phi_pg + phi_pg);
if (!phi_m.equals("planted") || !phi_buf.equals("planted")
        || !phi_letters.equals("planted") || !phi_pos.equals("planted"))
    phi_bad("the script wrote through to a global sharing a function-local's name");

// This file's own helpers have the same defect class, and it bit once: `phi_hex` used to
// reset the caller's loop counter, so a check that fired printed the same line for ever
// instead of failing.  Naming the globals is not enough to catch it -- phi_check returns
// before reaching phi_hex when the comparison passes -- so each helper is *called* here
// while the globals are planted.
phi_b = "planted";
phi_c = "planted";
phi_i = "planted";
phi_code = "planted";
phi_hex(phi_pg);
phi_bold("abc");
phi_glyph("pending");
if (!phi_b.equals("planted") || !phi_c.equals("planted")
        || !phi_i.equals("planted") || !phi_code.equals("planted"))
    phi_bad("a helper in this file wrote through to a global sharing its local's name");

// 20. a performance floor.  Both functions run on the AWT thread over whole selections, and
//     an interpreted per-character loop costs about 3.5 microseconds a character -- four to
//     nine seconds for this input, against tens of milliseconds compiled.  A two-second
//     ceiling is far above the compiled figures and far below the interpreted ones.
phi_block = new StringBuffer();
while (phi_block.length() < 448)
    phi_block.append("lemma foo: \"a + b = c\" by auto_sledgehammer\n");
phi_block.setLength(448);
phi_big = new StringBuffer();
while (phi_big.length() < 1000000) phi_big.append(phi_block).append(phi_pg);
phi_sample = phi_big.toString();
phi_t0 = System.currentTimeMillis();
phi_expanded = phi_word_expand(phi_tbl, phi_sample);
phi_ms1 = System.currentTimeMillis() - phi_t0;
phi_t0 = System.currentTimeMillis();
phi_word_fold(phi_tbl, phi_expanded);
phi_ms2 = System.currentTimeMillis() - phi_t0;
if (phi_ms1 > 2000 || phi_ms2 > 2000)
    phi_bad(phi_sample.length() + " characters took " + phi_ms1 + " ms to expand and "
            + phi_ms2 + " ms to fold; the per-character loop is back");

// 21. the font.  PhiSymbols carries a whole text face as well as the word glyphs, because a
//     Swing text component has one font for the whole component and the hand-drawn font
//     covers no printable ASCII at all -- see jedit/UI_FONT_PLAN.md.
//
//     Only coarse questions are asked here, and deliberately.  Whether ink appears at all
//     is the thing rendering answers that no antialiasing or fractional-metrics setting can
//     flip; everything exact about the merge -- outlines copied unchanged, advances, the em
//     correction -- is a statement about font data, and is checked as font data by
//     ../fonts/build_word_glyphs.py --check.
//
//     The font itself is registered at the top of this file, before the script is loaded.
// getFamily, not getName: getName hands back whatever family was asked for, so it answers
// "PhiSymbols" even when no such family exists and Dialog is what would be drawn.
phi_font = new java.awt.Font("PhiSymbols", java.awt.Font.PLAIN, 24);
if (!"PhiSymbols".equals(phi_font.getFamily()))
    phi_bad("the font did not resolve by family: " + phi_font.getFamily());

phi_draw(phi_text) {                    // what PhiSymbols puts on a blank white ground
    java.awt.image.BufferedImage phi_img = new java.awt.image.BufferedImage(
        300, 48, java.awt.image.BufferedImage.TYPE_INT_RGB);
    java.awt.Graphics2D phi_g = phi_img.createGraphics();
    phi_g.setColor(java.awt.Color.WHITE);
    phi_g.fillRect(0, 0, 300, 48);
    phi_g.setColor(java.awt.Color.BLACK);
    phi_g.setFont(new java.awt.Font("PhiSymbols", java.awt.Font.PLAIN, 24));
    phi_g.drawString(phi_text, 6, 36);
    phi_g.dispose();
    return phi_img;
}

phi_ink(phi_img) {
    int phi_lit = 0;
    for (int phi_y = 0; phi_y < 48; phi_y++)
        for (int phi_x = 0; phi_x < 300; phi_x++)
            if ((phi_img.getRGB(phi_x, phi_y) & 0xFFFFFF) != 0xFFFFFF) phi_lit++;
    return phi_lit;
}

if (phi_ink(phi_draw(phi_glyph("pending"))) == 0)
    phi_bad("a word glyph drew nothing in PhiSymbols");
// Two ASCII strings, because ink alone would prove nothing: a font missing a character
// draws .notdef, and this font's .notdef is a box with two contours, so any string at all
// would "draw".  Narrow letters and wide ones come out the same only as rows of boxes.
phi_narrow = phi_ink(phi_draw("iiiiii"));
phi_wide = phi_ink(phi_draw("MMMMMM"));
if (phi_narrow == 0 || phi_wide == 0)
    phi_bad("ordinary text drew nothing in PhiSymbols");
else if (phi_narrow == phi_wide)
    phi_bad("ordinary text is being drawn as notdef boxes: iiiiii and MMMMMM both came "
            + "out as " + phi_narrow + " pixels");

// Every field the listener has seen carries the family -- the two built in 18g as well as
// the two here.  phi_panel is 18g's.
phi_font_field = new HistoryTextField("phi-test");
phi_was_style = phi_font_field.getFont().getStyle();
phi_was_size = phi_font_field.getFont().getSize();
phi_panel.add(phi_font_field);
// and it hands it to a field wrapped on an earlier pass too, which is why the font is not
// set inside phi_wrap_field: that returns early for exactly this field
phi_panel.add(phi_area);
for (phi_seen : new Object[] { phi_bar_field, phi_dialog_area, phi_font_field, phi_area })
    if (!"PhiSymbols".equals(phi_seen.getFont().getFamily()))
        phi_bad("a field the listener saw carries family "
                + phi_seen.getFont().getFamily() + ", not PhiSymbols");
// Only the family changes.  Asserted because it is half the contract and nothing else
// looks: a phi_field_font that also reset the style and the size passed every check.
if (phi_font_field.getFont().getStyle() != phi_was_style
        || phi_font_field.getFont().getSize() != phi_was_size)
    phi_bad("the field's style or size changed with the family: was " + phi_was_style
            + "/" + phi_was_size + ", is " + phi_font_field.getFont().getStyle()
            + "/" + phi_font_field.getFont().getSize());

// 22. the X11 primary selection.  Selecting with the mouse writes register '%' with a bare
//     StringSelection and a middle click reads it back; no service list is consulted on
//     either side, so the wrapper phi_install_primary_selection puts there does both halves
//     itself -- expanding on the way out, folding on the way back.  Everything below is
//     driven through Registers, the way jEdit drives it.
//
//     Not against the platform's own selection: a stand-in register over a plain
//     java.awt.datatransfer.Clipboard is installed at '%' instead, because a real selection
//     can neither be made to throw nor be asked how often it was read.  The register the
//     load-time install wrapped is put back at the end.

// Planted first and left planted for the whole section: these are the names the
// primary-selection code binds inside its methods, and an untyped one there would write
// through to the global instead.  Same check as 19, done here because exercising those
// methods needs the stand-in register built below.
phi_primary = "planted";
phi_memo = "planted";
phi_selection = "planted";
phi_original = "planted";
phi_expanded = "planted";
phi_outer = "planted";
phi_now = "planted";
phi_sent = "planted";

phi_saved_pct = Registers.getRegister('%');
phi_sel_state = new java.util.HashMap();   // the fetch count, and the switch that throws
phi_sel_clip = new java.awt.datatransfer.Clipboard("phi-primary");
phi_stand_in = new Registers.Register() {
    public String toString() { return "phi-stand-in"; }
    public void setValue(String phi_v) { this.setTransferable(new StringSelection(phi_v)); }
    public void setTransferable(java.awt.datatransfer.Transferable phi_tr) {
        if (phi_sel_state.get("throw_set") != null)
            throw new IllegalStateException("the selection is busy");
        phi_sel_clip.setContents(phi_tr, null);
    }
    public java.awt.datatransfer.Transferable getTransferable() {
        Integer phi_was = phi_sel_state.get("fetches");
        phi_sel_state.put("fetches",
                          new Integer(phi_was == null ? 1 : phi_was.intValue() + 1));
        return phi_sel_clip.getContents(null);
    }
};

phi_sel_read() {                        // what jEdit pastes, read through the wrapper
    return Registers.getRegister('%').getTransferable()
               .getTransferData(DataFlavor.stringFlavor);
}
phi_sel_out() {                         // what another application sees on the selection
    return phi_sel_clip.getContents(null).getTransferData(DataFlavor.stringFlavor);
}

// First the install that phi_word_install itself does, driven against the platform's own
// primary selection -- an isolated Xvfb display, never the user's.  Without this the whole
// section would pass with the call struck out of phi_word_install, because every check
// below installs the wrapper itself; and it is the only place the wrapper is exercised over
// jEdit's real ClipboardRegister rather than over the stand-in.
Registers.setRegister('%', phi_pg);
phi_check("the load-time install reaches the platform's primary selection",
          java.awt.Toolkit.getDefaultToolkit().getSystemSelection().getContents(null)
              .getTransferData(DataFlavor.stringFlavor), phi_pending);
phi_check("and the platform's selection reads back as the glyph", phi_sel_read(), phi_pg);

Registers.setRegister('%', phi_stand_in);
phi_install_primary_selection();
if (Registers.getRegister('%') == phi_stand_in)
    phi_bad("the primary-selection wrapper was not installed");
// decision 1 of PRIMARY_SELECTION_PLAN.md: nothing in the shipped configuration reads it,
// and it delegates.  Checked because "nothing reads it" is exactly when a wrong one hides.
phi_check("toString delegates to the register underneath",
          Registers.getRegister('%').toString(), "phi-stand-in");

// a. a mouse selection of a word glyph
Registers.setRegister('%', phi_pg);
phi_check("a selected glyph leaves as letters", phi_sel_out(), phi_pending);
phi_check("and jEdit reads it back as the glyph", phi_sel_read(), phi_pg);

// b. a glyph written against mathematical letters no word claims.  Folding cannot repair
//    this shape -- the run is somebody else's bold text and none of it may be touched -- so
//    the round trip is exact only because the wrapper remembers what it last published.
phi_sel_zzz = phi_pg + phi_zzz;
Registers.setRegister('%', phi_sel_zzz);
phi_check("glyph against unclaimed letters leaves as letters",
          phi_sel_out(), phi_pending + phi_zzz);
phi_check("and the memo makes that round trip exact", phi_sel_read(), phi_sel_zzz);
phi_check("folding alone would not have repaired it",
          phi_word_fold(phi_tbl, phi_pending + phi_zzz), phi_pending + phi_zzz);

// c. the memo is not infallible, and the plan does not pretend it is: another application
//    publishing character for character what the wrapper last put out is answered from the
//    memo.  The user gets back what they last selected in jEdit, so it is not corruption --
//    but it is a real behaviour, pinned here rather than denied.
phi_sel_clip.setContents(new StringSelection(phi_pending + phi_zzz), null);
phi_check("a foreign string equal to the remembered expansion returns the remembered text",
          phi_sel_read(), phi_sel_zzz);

// d. the ordinary foreign cases: letters fold, everything else is left alone, both ways
phi_sel_clip.setContents(new StringSelection(phi_pending), null);
phi_check("letters from another application fold", phi_sel_read(), phi_pg);
phi_sel_clip.setContents(new StringSelection("int foo = 1;"), null);
phi_check("ordinary text from another application is untouched",
          phi_sel_read(), "int foo = 1;");
Registers.setRegister('%', "int foo = 1;");
phi_check("ordinary text goes out untouched", phi_sel_out(), "int foo = 1;");

// e. one fetch per read.  A second phi_primary.getTransferable() would cost another
//    blocking round trip to whichever application owns the selection, so the failure path
//    hands back the transferable already in hand rather than asking again.
phi_sel_state.put("fetches", new Integer(0));
phi_sel_read();
if (phi_sel_state.get("fetches").intValue() != 1)
    phi_bad("reading the selection fetched it " + phi_sel_state.get("fetches")
            + " times, not once");
phi_sel_clip.setContents(phi_thrower, null);        // claims the flavor, throws on the data
phi_sel_state.put("fetches", new Integer(0));
phi_sel_fell_back = Registers.getRegister('%').getTransferable();
if (phi_sel_state.get("fetches").intValue() != 1)
    phi_bad("the failure path fetched the selection " + phi_sel_state.get("fetches")
            + " times, not once");
if (phi_sel_fell_back != phi_thrower)
    phi_bad("the failure path did not hand back the transferable already in hand");

// f. a selection that throws.  Both write paths are guarded, the pass-through one included:
//    written after the try rather than inside it, a throw there would escape onto the AWT
//    event thread, which is the one thread this wrapper must never break.
phi_sel_opaque = new java.awt.datatransfer.Transferable() {   // no flavor to expand
    public DataFlavor[] getTransferDataFlavors() { return new DataFlavor[0]; }
    public boolean isDataFlavorSupported(DataFlavor phi_f) { return false; }
    public Object getTransferData(DataFlavor phi_f) { return null; }
};
phi_sel_state.put("throw_set", Boolean.TRUE);
try { Registers.setRegister('%', phi_pg); }
catch (Exception e) { phi_bad("a throwing selection escaped the expanding path: " + e); }
try { Registers.setRegister('%', phi_sel_opaque); }
catch (Exception e) { phi_bad("a throwing selection escaped the pass-through path: " + e); }
phi_sel_state.remove("throw_set");

// g. platforms with no primary selection: registers['%'] starts null and the install must
//    return early.  That state cannot be produced on X11, so it is written into jEdit's own
//    register table and put back immediately -- setRegister cannot store a null Register,
//    its Transferable overload takes the call instead.
phi_reg_field = Class.forName("org.gjt.sp.jedit.Registers").getDeclaredField("registers");
phi_reg_field.setAccessible(true);
phi_reg_table = phi_reg_field.get(null);
phi_wrapped_pct = Registers.getRegister('%');
java.lang.reflect.Array.set(phi_reg_table, (int) '%', null);
phi_install_primary_selection();
if (Registers.getRegister('%') != null)
    phi_bad("the install did not return early where there is no primary selection");
java.lang.reflect.Array.set(phi_reg_table, (int) '%', phi_wrapped_pct);

// h. installed twice -- a second wrapper around the first.  With one shared top-level map
//    instead of one per wrapper, the outer would store into the map the inner reads and the
//    glyph would come back as letters.
phi_install_primary_selection();
Registers.setRegister('%', phi_pg);
phi_check("installed twice, a glyph still leaves as letters", phi_sel_out(), phi_pending);
phi_check("installed twice, it still reads back as the glyph", phi_sel_read(), phi_pg);

Registers.setRegister('%', phi_saved_pct);
if (!"planted".equals(phi_primary) || !"planted".equals(phi_memo)
        || !"planted".equals(phi_selection) || !"planted".equals(phi_original)
        || !"planted".equals(phi_expanded) || !"planted".equals(phi_outer)
        || !"planted".equals(phi_now) || !"planted".equals(phi_sent))
    phi_bad("the primary-selection wrapper wrote through to a global sharing a local's name");

// 23. what arrives on a drop.  Drag reaches neither of the hooks the other directions use --
//     no service list, no register -- so the handler installed on every buffer text area
//     rewrites the incoming text itself, in phi_unexpand.  Two things it must get right: a
//     drag jEdit itself started has to come back exactly, because a move drag deletes the
//     source text before re-inserting it and an inexact round trip would rewrite the buffer
//     rather than merely fail to restore a glyph; and a file dragged in from a file manager
//     has to go on opening.
//
//     Planted first and left planted through 25: these are the names the drag code binds
//     inside its methods, and an untyped one there would write through to the global instead
//     of making a local.  Same check as 19 and 22, spanning three sections because the same
//     names run through all of them.
phi_drag_locals = new String[] {
    "phi_inner", "phi_replacement", "phi_w", "phi_f", "phi_in", "phi_fl", "phi_s", "phi_out",
    "phi_sent", "phi_c", "phi_base", "phi_original", "phi_expanded", "phi_tr", "phi_action",
    "phi_bus_listener", "phi_msg" };
for (String phi_planted : phi_drag_locals)
    this.namespace.setVariable(phi_planted, "planted", false);

phi_fetches = new int[1];               // an array, so no helper needs to write through
phi_string_of(phi_transferable) {
    return phi_transferable.getTransferData(DataFlavor.stringFlavor);
}

// Counts every fetch, and carries jEdit's rich flavor beside the plain one so that the
// wrapper can be asked to hand a flavor it does not replace straight on.
phi_counting(phi_txt) {
    Object phi_ct = new java.awt.datatransfer.Transferable() {
        public DataFlavor[] getTransferDataFlavors() {
            return new DataFlavor[] { DataFlavor.stringFlavor,
                                      JEditDataFlavor.jEditRichTextDataFlavor };
        }
        public boolean isDataFlavorSupported(DataFlavor phi_ff) {
            return DataFlavor.stringFlavor.equals(phi_ff)
                   || JEditDataFlavor.jEditRichTextDataFlavor.equals(phi_ff);
        }
        public Object getTransferData(DataFlavor phi_ff) {
            phi_fetches[0] = phi_fetches[0] + 1;
            if (JEditDataFlavor.jEditRichTextDataFlavor.equals(phi_ff))
                return new org.gjt.sp.jedit.datatransfer.JEditRichText(phi_txt, "text");
            return phi_txt;
        }
    };
    return phi_ct;
}

// a. a drag jEdit started, in the shape folding cannot repair.  \<size>_\<then'> expands to
//    the letters of `size_then`, which fold as `size_t` -- a word in its own right -- and a
//    tail of `hen` that no word claims, so the whole run is abandoned.  The two slots are
//    what makes the round trip exact anyway.
phi_size_then_letters = phi_word_expand(phi_tbl, phi_size_then);
phi_drag.clear();
phi_drag.put("original", phi_size_then);
phi_drag.put("expanded", phi_size_then_letters);
phi_check("a drag we started comes back as the text it was made from",
          phi_string_of(phi_unexpand(new StringSelection(phi_size_then_letters))),
          phi_size_then);
phi_check("folding alone would not have restored it",
          phi_word_fold(phi_tbl, phi_size_then_letters), phi_size_then_letters);

// b. a string this code did not produce is folded, not restored
phi_check("letters from another application fold",
          phi_string_of(phi_unexpand(new StringSelection(phi_pending))), phi_pg);

// c. nothing to fold, and the transferable is still wrapped.  Returning the original would
//    make importText fetch the string a second time -- on X11 a second blocking selection
//    transfer on the AWT thread, on the commonest path there is.  The wrapper delegates
//    every flavor it does not replace, which is what keeps jEdit's own dispatch alive.
phi_plain_probe = phi_counting("int foo = 1;");
phi_fetches[0] = 0;
phi_wrapped_drop = phi_unexpand(phi_plain_probe);
if (phi_wrapped_drop == phi_plain_probe)
    phi_bad("with nothing to fold the transferable was handed back rather than wrapped");
phi_check("ordinary text is untouched", phi_string_of(phi_wrapped_drop), "int foo = 1;");
if (phi_fetches[0] != 1)
    phi_bad("the dropped string was fetched " + phi_fetches[0] + " times, not once");
// in a try of its own: a wrapper that replaced the transferable instead of delegating
// throws UnsupportedFlavorException here, and a check has to name itself whichever way it
// fails rather than take the whole run down
try {
    if (!(phi_wrapped_drop.getTransferData(JEditDataFlavor.jEditRichTextDataFlavor)
              instanceof org.gjt.sp.jedit.datatransfer.JEditRichText))
        phi_bad("the wrapper did not delegate a flavor it does not replace");
}
catch (Exception e) {
    phi_bad("the wrapper did not delegate a flavor it does not replace: " + e);
}
if (phi_wrapped_drop.getTransferDataFlavors().length != 2
        || !phi_wrapped_drop.isDataFlavorSupported(JEditDataFlavor.jEditRichTextDataFlavor))
    phi_bad("the wrapper did not report the flavors of the transferable underneath");

// d. nothing to work with: the same object goes back, so jEdit sees exactly what it would
//    have seen without any of this
phi_no_string = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() { return new DataFlavor[0]; }
    public boolean isDataFlavorSupported(DataFlavor phi_ff) { return false; }
    public Object getTransferData(DataFlavor phi_ff) { return null; }
};
phi_null_string = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() {
        return new DataFlavor[] { DataFlavor.stringFlavor };
    }
    public boolean isDataFlavorSupported(DataFlavor phi_ff) { return true; }
    public Object getTransferData(DataFlavor phi_ff) { return null; }
};
if (phi_unexpand(null) != null) phi_bad("null did not come back as null");
if (phi_unexpand(phi_no_string) != phi_no_string)
    phi_bad("a transferable with no plain text did not come back untouched");
if (phi_unexpand(phi_null_string) != phi_null_string)
    phi_bad("a transferable whose plain text is null did not come back untouched");

// e. the file-drop guards.  jEdit dispatches on these two flavors before it looks at text at
//    all, so the transferable must arrive untouched -- and its string must not be fetched,
//    because that would force a blocking cross-process transfer jEdit never asked for.
phi_file_drop = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() {
        return new DataFlavor[] { DataFlavor.javaFileListFlavor, DataFlavor.stringFlavor };
    }
    public boolean isDataFlavorSupported(DataFlavor phi_ff) { return true; }
    public Object getTransferData(DataFlavor phi_ff) {
        phi_fetches[0] = phi_fetches[0] + 1;
        return "file:///tmp/a.thy";
    }
};
phi_uri_flavor = new DataFlavor("text/uri-list;class=java.lang.String");
phi_uri_drop = new java.awt.datatransfer.Transferable() {
    public DataFlavor[] getTransferDataFlavors() {
        return new DataFlavor[] { phi_uri_flavor, DataFlavor.stringFlavor };
    }
    public boolean isDataFlavorSupported(DataFlavor phi_ff) {
        return !DataFlavor.javaFileListFlavor.equals(phi_ff);
    }
    public Object getTransferData(DataFlavor phi_ff) {
        phi_fetches[0] = phi_fetches[0] + 1;
        return "file:///tmp/a.thy";
    }
};
phi_fetches[0] = 0;
if (phi_unexpand(phi_file_drop) != phi_file_drop)
    phi_bad("a file drop did not come back untouched; jEdit would stop opening the file");
if (phi_unexpand(phi_uri_drop) != phi_uri_drop)
    phi_bad("a uri-list drop did not come back untouched");
if (phi_fetches[0] != 0)
    phi_bad("a drop jEdit dispatches on its flavors had its string fetched "
            + phi_fetches[0] + " times");

// f. a transferable that throws.  On X11 an IOException from a foreign drag source is
//    routine, and an uncaught one leaves jEdit's compound edit open and its dragSource
//    non-null where the stock handler leaves both clean.
try {
    if (phi_unexpand(phi_thrower) != phi_thrower)
        phi_bad("a throwing transferable did not come back untouched");
}
catch (Exception e) { phi_bad("a throwing transferable escaped phi_unexpand: " + e); }

// 24. the handler itself, driven on real text areas.  A JEditTextArea can be built without a
//     running jEdit, which lifts this from "the helper behaves" to "a drop through jEdit's
//     own importText puts the right characters in a real buffer" -- most of what manual
//     checks 1 and 2 do.
// jEdit's undo manager pushes every deletion onto the kill ring, whose singleton is
// normally set up during startup; without this a setText over existing content dies in
// KillRing.add.
org.gjt.sp.jedit.buffer.KillRing.getInstance().propertiesChanged(10);

phi_text_area() {
    Object phi_ta = new JEditTextArea(null);
    // both before setBuffer: the painter throws on a null FontMetrics and the syntax
    // chunker on null styles
    phi_ta.getPainter().setFont(new java.awt.Font("Monospaced", 0, 12));
    phi_ta.getPainter().setStyles(new SyntaxStyle[Token.ID_COUNT]);
    phi_ta.setBuffer(new JEditBuffer());
    return phi_ta;
}

// jEdit keeps its whole drag bookkeeping in private statics of one class, because a drag
// started in one EditPane is finished by another pane's handler instance
phi_tath_field(phi_which) {
    java.lang.reflect.Field phi_fld =
        TextAreaTransferHandler.class.getDeclaredField(phi_which);
    phi_fld.setAccessible(true);
    return phi_fld;
}

phi_handler_a = new Phi_Text_Area_Transfer_Handler();
if (!(phi_handler_a instanceof TextAreaTransferHandler))
    phi_bad("the drag handler is not a TextAreaTransferHandler");

// a. the three overrides are declared public where the superclass declares them protected.
//    bsh resolves super.<method> by a public-method lookup on the superclass and cannot fall
//    back on accessibility, so a protected one installs cleanly and then fails at the first
//    drag -- invisible to everything else in this file.
phi_public_override(phi_cls, phi_which, phi_types) {
    try {
        java.lang.reflect.Method phi_meth = phi_cls.getDeclaredMethod(phi_which, phi_types);
        if (!java.lang.reflect.Modifier.isPublic(phi_meth.getModifiers()))
            phi_bad(phi_which + " is declared "
                    + java.lang.reflect.Modifier.toString(phi_meth.getModifiers())
                    + ", not public; bsh cannot reach super and the first drag fails");
    }
    catch (Exception e) {
        phi_bad("no override " + phi_which + " with the superclass's signature: " + e);
    }
}
phi_public_override(phi_handler_a.getClass(), "createTransferable",
                    new Class[] { javax.swing.JComponent.class });
phi_public_override(phi_handler_a.getClass(), "importData",
                    new Class[] { javax.swing.JComponent.class,
                                  java.awt.datatransfer.Transferable.class });
phi_public_override(phi_handler_a.getClass(), "exportDone",
                    new Class[] { javax.swing.JComponent.class,
                                  java.awt.datatransfer.Transferable.class, Integer.TYPE });

// b. super is reached, not merely named: the superclass body casts its argument to a
//    JEditTextArea, so a JPanel must fail there and nowhere else
try {
    phi_handler_a.createTransferable(new javax.swing.JPanel());
    phi_bad("super.createTransferable did not run: a JPanel must fail the cast inside it");
}
catch (Exception e) {
    if (("" + e).indexOf("ClassCastException") < 0)
        phi_bad("super.createTransferable did not reach the superclass body: " + e);
}

// c. dragging out of a buffer
phi_ta_a = phi_text_area();
phi_ta_b = phi_text_area();
phi_ta_a.setText("x" + phi_size_then + "y");
phi_ta_a.setSelection(new Selection.Range(1, 1 + phi_size_then.length()));
phi_dragged = phi_handler_a.createTransferable(phi_ta_a);
phi_check("a drag out of a buffer carries the letters",
          phi_string_of(phi_dragged), phi_size_then_letters);
if (!phi_size_then.equals(phi_drag.get("original"))
        || !phi_size_then_letters.equals(phi_drag.get("expanded")))
    phi_bad("createTransferable did not fill the slots: " + phi_drag);

// d. dropping into another text area, through a *different* handler instance -- which is the
//    real shape: importData runs on the destination pane's handler and exportDone on the
//    source's, so the slots have to be shared across instances.
//
//    jEdit's own importData ends by calling GUIUtilities.getView(c).toFront(), which needs a
//    running View, so headless it throws after the insertion has already happened and the
//    override returns false where a running jEdit returns true.  That is not a defect under
//    test -- and it is the one place the guard is exercised against a real throw out of
//    super, so this checks both halves: the glyphs are in the destination buffer, and nothing
//    escaped.  The log is silenced across it because the guard logs what it caught.
phi_handler_b = new Phi_Text_Area_Transfer_Handler();
phi_ta_b.setText("");
Log.init(false, 100);
try { phi_handler_b.importData(phi_ta_b, phi_dragged); }
catch (Exception e) { phi_bad("a throw out of super escaped importData: " + e); }
finally { Log.init(false, Log.WARNING); }
phi_check("a drop into another text area restores the glyphs",
          phi_ta_b.getText(), phi_size_then);

// e. letters dropped in from another application, through jEdit's own importText.  The
//    string must be fetched once: phi_unexpand has already paid for it, and handing back the
//    original transferable would make importText fetch it again -- on X11 a second blocking
//    transfer on the AWT thread.  dragSource is set rather than left wherever the last drag
//    put it, because when it is null jEdit treats every line as a URL to load instead.
phi_tath_field("dragSource").set(null, phi_ta_a);
phi_drag.clear();
phi_ta_b.setText("");
phi_fetches[0] = 0;
Log.init(false, 100);
try { phi_handler_b.importData(phi_ta_b, phi_counting(phi_pending)); }
catch (Exception e) { phi_bad("a throw out of super escaped importData: " + e); }
finally { Log.init(false, Log.WARNING); }
phi_check("letters dropped in from another application arrive as the glyph",
          phi_ta_b.getText(), phi_pg);
if (phi_fetches[0] != 1)
    phi_bad("the dropped string was fetched " + phi_fetches[0]
            + " times through importText, not once");

// f. a drag that stayed inside one text area.  exportDone has its own re-insertion branch,
//    reading the plain text again, so without folding there a drag within one pane would
//    deposit letters.  jEdit's bookkeeping for that branch is private static and is set here
//    directly: reaching it through a real gesture needs a mouse.
phi_ta_a.setText("x" + phi_size_then + "y");
phi_ta_a.setSelection(new Selection.Range(1, 1 + phi_size_then.length()));
phi_dragged = phi_handler_a.createTransferable(phi_ta_a);
phi_tath_field("dragSource").set(null, phi_ta_a);
phi_tath_field("sameTextArea").set(null, Boolean.TRUE);
phi_tath_field("insertPos").set(null, new Integer(0));
phi_tath_field("insertOffset").set(null, new Integer(0));
Log.init(false, 100);
try {
    phi_handler_a.exportDone(phi_ta_a, phi_dragged, javax.swing.TransferHandler.MOVE);
}
catch (Exception e) { phi_bad("a throw out of super escaped exportDone: " + e); }
finally { Log.init(false, Log.WARNING); }
phi_check("a drag within one text area moves the glyphs, not their letters",
          phi_ta_a.getText(), phi_size_then + "xy");
if (!phi_drag.isEmpty()) phi_bad("exportDone left the slots filled: " + phi_drag);

// g. the slots are cleared on the way in as well as on the way out, because either end can
//    be skipped -- exportToClipboard reaches exportDone only on success, and jEdit returns
//    from it early whenever the drag ended in no action at all.  An empty selection is the
//    cheapest way to show the clearing happens before anything else.
phi_drag.put("original", "stale");
phi_drag.put("expanded", "stale");
phi_ta_a.selectNone();
if (phi_handler_a.createTransferable(phi_ta_a) != null)
    phi_bad("an empty selection produced a transferable");
if (!phi_drag.isEmpty())
    phi_bad("createTransferable did not clear the slots first: " + phi_drag);

// 25. the installation.  A text area gets its handler when its EditPane is created, off the
//     EditBus, and putting the component there is what phi_word_install does -- everything in
//     23 and 24 passes with that call struck out of it, which is exactly how the check on the
//     primary-selection wrapper failed to bite until it was noticed.  What cannot be checked
//     here is the handler's reaction: an EditPaneUpdate carries an EditPane, and
//     View.createEditPane is the only place one is ever built.  That stays a manual check.
phi_bus_field = Class.forName("org.gjt.sp.jedit.EditBus").getDeclaredField("components");
phi_bus_field.setAccessible(true);
phi_bus_map = phi_bus_field.get(null);
phi_comp_field =
    Class.forName("org.gjt.sp.jedit.EditBus$EBMessageHandler").getDeclaredField("comp");
phi_comp_field.setAccessible(true);

// bsh implements a lone interface with a JDK proxy, so every EBComponent written in this
// interpreter has a proxy class, while jEdit's own subscribers are ordinary classes.
// Counting the proxies is therefore counting ours -- which is why the probe below is added
// after the counting and taken off again straight away.
phi_bus_ours() {
    int phi_seen_n = 0;
    Object phi_list = phi_bus_map.get(EBMessage.class);
    if (phi_list == null) return 0;
    for (Object phi_emh : phi_list) {
        Object phi_comp = phi_comp_field.get(phi_emh);
        if (phi_comp instanceof EBComponent
                && java.lang.reflect.Proxy.isProxyClass(phi_comp.getClass()))
            phi_seen_n = phi_seen_n + 1;
    }
    return phi_seen_n;
}
if (phi_bus_ours() != 1)
    phi_bad("phi_word_install put " + phi_bus_ours()
            + " drag components on the bus at load time, not one");
// installing twice is benign, and pinned rather than argued: it replaces each text area's
// handler instead of nesting one wrapper inside another, so a second component simply sets
// the same handler twice on every pane created afterwards
phi_install_drag();
if (phi_bus_ours() != 2)
    phi_bad("a second install did not add exactly one more drag component to the bus");

// The guard inside handleMessage protects other people's subscribers, not this code: an
// EBComponent is registered under EBMessage.class and so sees every message, and EditBus
// wraps its whole handler loop in one try -- one throw and every subscriber behind it
// receives nothing.  jEdit's own DockingLayoutManager and Isabelle's symbols dockable are
// behind us.  An EditPaneUpdate whose EditPane is null makes the handler throw.
phi_probe_seen = new int[1];
phi_bus_probe = new EBComponent() {
    public void handleMessage(EBMessage phi_m2) {
        phi_probe_seen[0] = phi_probe_seen[0] + 1;
    }
};
EditBus.addToBus(phi_bus_probe);
Log.init(false, 100);
try { EditBus.send(new EditPaneUpdate(null, EditPaneUpdate.CREATED)); }
finally { Log.init(false, Log.WARNING); }
EditBus.removeFromBus(phi_bus_probe);
if (phi_probe_seen[0] == 0)
    phi_bad("a throw inside the drag component stopped the bus, so every subscriber behind "
            + "it received nothing");

// and the names planted at the start of 23
for (String phi_planted : phi_drag_locals)
    if (!"planted".equals(this.namespace.getVariable(phi_planted)))
        phi_bad("the drag code wrote through to the global " + phi_planted
                + ", which is one of its own function-locals' names: it is not declared"
                + " with a type");

System.out.println((phi_failures[0] == 0 ? "PASS" : "FAILED") + ": " + phi_n
                   + " entries round-tripped, " + phi_pairs + " adjacent pairs, "
                   + phi_sample.length() + " characters in " + phi_ms1 + "/" + phi_ms2
                   + " ms, " + phi_failures[0] + " failure(s)");
// Explicitly, and for success as well: building a JEditTextArea starts threads that are not
// daemons, so the interpreter would otherwise never return.
System.exit(phi_failures[0] == 0 ? 0 : 1);
