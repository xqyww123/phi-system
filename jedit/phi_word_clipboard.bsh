// Word glyphs must survive the clipboard in both directions.
//
// phi-System draws each keyword as one glyph on one Unicode private-use code point
// (see fonts/WORD_GLYPHS.md).  Inside jEdit that is exactly what you want; outside it
// there is no font and no meaning, so a plain copy hands other applications U+E048
// instead of "pending".  This script makes copying produce the word in mathematical
// bold letters -- the same letters the glyph was drawn from, so the pasted text looks
// like what was on screen -- and makes pasting turn those letters back into the glyph.
//
// The two directions hook different points of jEdit:
//
//   copy   org.gjt.sp.jedit.datatransfer.TransferHandler holds a list of services, each
//          contributing data flavors; later ones overwrite earlier ones, and startup
//          scripts run after jEdit has registered its own.  A service registered here
//          offering only the plain-text flavor therefore replaces the plain text.
//          jEdit's own rich-text flavor is left alone, and since Registers.paste
//          prefers it -- and it is a JVM-local object no other process can see --
//          pasting back inside jEdit still yields the glyph itself.
//
//   paste  has no service list.  Instead the clipboard register is wrapped: its
//          getTransferable reports the plain text with the letters folded back into
//          glyphs, unless jEdit's rich-text flavor is present, in which case the text
//          came from jEdit and is handed over untouched.
//
// jedit/word-clipboard-text is generated by fonts/build_word_glyphs.py, so the letters
// used here can never drift from the letters the glyphs were drawn from.
//
// phi-System's etc/settings links this file into $JEDIT_SETTINGS/startup, so it runs
// whenever jEdit starts with the component registered.

import java.awt.datatransfer.DataFlavor;
import java.awt.datatransfer.StringSelection;
import java.awt.datatransfer.Transferable;
import org.gjt.sp.jedit.Registers;
import org.gjt.sp.jedit.datatransfer.JEditDataFlavor;
import org.gjt.sp.jedit.datatransfer.JEditTransferableService;
import org.gjt.sp.jedit.datatransfer.TransferHandler;
import org.gjt.sp.util.Log;

/* the generated table: glyph code point <-> the letters it reads as */

phi_word_table()
{
    t = new java.util.HashMap();            // "expand": Integer code point -> String letters
    t.put("expand", new java.util.HashMap());
    t.put("fold", new java.util.HashMap()); // String letters -> String glyph
    t.put("letters", new java.util.HashSet());
    t.put("keys", new java.util.ArrayList());

    home = System.getenv("PHI_SYSTEM_HOME");
    if (home == null) return t;
    file = new java.io.File(home, "jedit/word-clipboard-text");
    if (!file.isFile()) return t;

    for (line : java.nio.file.Files.readAllLines(file.toPath())) {
        line = line.trim();
        if (line.isEmpty() || line.startsWith("#")) continue;
        parts = line.split("\\s+", 2);
        if (parts.length != 2) continue;
        code = Integer.decode(parts[0]).intValue();
        letters = parts[1];
        glyph = new String(Character.toChars(code));
        t.get("expand").put(new Integer(code), letters);
        t.get("fold").put(letters, glyph);
        t.get("keys").add(letters);
        for (i = 0; i < letters.length(); ) {
            c = letters.codePointAt(i);
            t.get("letters").add(new Integer(c));
            i += Character.charCount(c);
        }
    }
    // longest first, so that folding a run of adjacent words is unambiguous
    java.util.Collections.sort(t.get("keys"), new java.util.Comparator() {
        public int compare(a, b) { return b.length() - a.length(); }
    });
    return t;
}

/* leaving jEdit: glyph -> letters */

phi_word_expand(t, text)
{
    if (text == null) return text;
    expand = t.get("expand");
    buf = new StringBuilder(text.length());
    for (i = 0; i < text.length(); ) {
        code = text.codePointAt(i);
        width = Character.charCount(code);
        letters = expand.get(new Integer(code));
        if (letters == null) buf.append(text, i, i + width); else buf.append(letters);
        i += width;
    }
    return buf.toString();
}

/* entering jEdit: letters -> glyph, but only where a whole run of letters is words */

phi_word_fold_run(t, run)
{
    fold = t.get("fold");
    keys = t.get("keys");
    buf = new StringBuilder();
    i = 0;
    while (i < run.length()) {
        hit = null;
        for (key : keys) {
            if (run.startsWith(key, i)) { hit = key; break; }
        }
        if (hit != null) { buf.append(fold.get(hit)); i += hit.length(); continue; }
        // A word may be written against punctuation -- a full stop after it, an
        // underscore or a digit joined to it -- so ASCII that no word claims is
        // carried over.  A mathematical letter that no word claims is different: the
        // run is then somebody else's bold text, and none of it may be touched.
        code = run.codePointAt(i);
        if (code > 127) return run;
        buf.append(run, i, i + Character.charCount(code));
        i += Character.charCount(code);
    }
    return buf.toString();
}

phi_word_fold(t, text)
{
    if (text == null) return text;
    letters = t.get("letters");
    buf = new StringBuilder(text.length());
    i = 0;
    while (i < text.length()) {
        code = text.codePointAt(i);
        if (!letters.contains(new Integer(code))) {
            buf.append(text, i, i + Character.charCount(code));
            i += Character.charCount(code);
            continue;
        }
        j = i;                              // widen to the whole run of such letters
        while (j < text.length()) {
            c = text.codePointAt(j);
            if (!letters.contains(new Integer(c))) break;
            j += Character.charCount(c);
        }
        buf.append(phi_word_fold_run(t, text.substring(i, j)));
        i = j;
    }
    return buf.toString();
}

/* installation */

phi_word_install()
{
    t = phi_word_table();
    n = t.get("expand").size();
    if (n == 0) {
        Log.log(Log.WARNING, this, "phi word clipboard: no table found, not installed");
        return;
    }

    // BeanShell cannot parse an anonymous class body written directly as an argument,
    // so both of these are bound to a name first.
    service = new JEditTransferableService() {
        public boolean accept(textArea, text) { return true; }
        public Transferable getTransferable(textArea, text) {
            return new StringSelection(phi_word_expand(t, text));
        }
    };
    TransferHandler.getInstance().registerTransferableService(service);

    clipboard = Registers.getRegister('$');
    wrapper = new Registers.Register() {
        public String toString() { return clipboard.toString(); }
        public void setValue(String value) { clipboard.setValue(value); }
        public void setTransferable(Transferable t2) { clipboard.setTransferable(t2); }
        public Transferable getTransferable() {
            outer = clipboard.getTransferable();
            if (outer == null) return null;
            // text jEdit itself put there: it still carries the glyphs, take it as is
            if (outer.isDataFlavorSupported(JEditDataFlavor.jEditRichTextDataFlavor)) return outer;
            if (!outer.isDataFlavorSupported(DataFlavor.stringFlavor)) return outer;
            try {
                return new StringSelection(phi_word_fold(t, outer.getTransferData(DataFlavor.stringFlavor)));
            }
            catch (Exception e) { return outer; }
        }
    };
    Registers.setRegister('$', wrapper);

    Log.log(Log.NOTICE, this, "phi word clipboard: " + n + " words expand on copy, fold on paste");
}

phi_word_install();
