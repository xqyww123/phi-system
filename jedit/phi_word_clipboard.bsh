// Word glyphs must survive the clipboard in both directions.
//
// phi-System draws each keyword as one glyph on one Unicode private-use code point
// (see fonts/WORD_GLYPHS.md).  Inside jEdit that is exactly what you want; outside it
// there is no font and no meaning, so a plain copy hands other applications U+E048
// instead of "pending".  This script makes copying produce the word in mathematical
// letters -- the same letters the glyph was drawn from, so the pasted text looks like
// what was on screen -- and makes pasting turn those letters back into the glyph.
//
// Two glyphs written directly against each other need one thing more.  Their letters
// run together on the clipboard and the paste direction can no longer tell where the
// first word ended: \<or'>\<else> expands to "orelse", which folds back to the single
// symbol \<orelse> -- the text has quietly changed meaning.  Expansion therefore emits
// a U+2060 WORD JOINER between two adjacent glyphs.  A joiner is not a run-forming
// character, so it ends a run and each expansion folds on its own; folding strips every
// U+2060 from its result, unconditionally, so none is ever written into a buffer.
//
// The two directions hook different points of jEdit:
//
//   copy   org.gjt.sp.jedit.datatransfer.TransferHandler holds a list of services, each
//          contributing data flavors; later ones overwrite earlier ones, and startup
//          scripts run after jEdit has registered its own.  A service registered here
//          offering only the plain-text flavor therefore replaces the plain text.
//          jEdit's own rich-text flavor is left alone, and since Registers.paste
//          prefers it -- and it is a JVM-local object no other process can see --
//          pasting back inside jEdit still yields the glyph itself.
//
//   paste  has no service list.  Instead the clipboard register is wrapped: its
//          getTransferable reports the plain text with the letters folded back into
//          glyphs, unless jEdit's rich-text flavor is present, in which case the text
//          came from jEdit and is handed over untouched.
//
//   paste into jEdit's own text input fields -- the Search and Replace boxes, the
//          quick-search bar, the file browser's boxes, Isabelle's Query, Sledgehammer
//          and Debugger fields -- goes through neither of those.  They are plain Swing
//          text components whose stock TransferHandler reads the plain-text flavor, so
//          the field would receive the letters while the buffer holds the glyph and the
//          search would match nothing.  Each field's handler is therefore wrapped in a
//          delegating one, and the fields are found with a global AWT listener because
//          they are built lazily inside dialogs and nothing announces them.
//
//   select the X11 primary selection has no copy command at all: whatever the mouse
//          selects goes there, and a middle click pastes it.  jEdit maps it to register
//          '%', which no service list touches -- both of its writers build a bare
//          StringSelection -- so that wrapper does both halves itself, expanding in
//          setTransferable and folding in getTransferable.
//
//   drag   reaches none of the three.  TextAreaTransferHandler hands out a bare
//          StringSelection over the selected text and reads the plain text straight back
//          on the way in, so the handler itself is subclassed and installed on every text
//          area as it is created.  It also remembers the last string it handed out: a drag
//          that stays inside jEdit puts back the text that string was made from rather than
//          folding it, because a move drag deletes the source before re-inserting it and
//          folding does not repair every shape.
//
// Both directions are driven by patterns compiled once, when the table is built, and
// never inside a loop: a selection can be millions of characters and every return to
// the BeanShell interpreter costs about 3.5 microseconds.  See WORD_BOUNDARY_PLAN.md,
// "What makes it fast", before simplifying any of it back.
//
// jedit/word-clipboard-text is generated by fonts/build_word_glyphs.py, so the letters
// used here can never drift from the letters the glyphs were drawn from.
//
// phi-System's etc/settings links this file into $JEDIT_SETTINGS/startup, so it runs
// whenever jEdit starts with the component registered.

import java.awt.datatransfer.Clipboard;
import java.awt.datatransfer.DataFlavor;
import java.awt.datatransfer.StringSelection;
import java.awt.datatransfer.Transferable;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.gjt.sp.jedit.EBComponent;
import org.gjt.sp.jedit.EBMessage;
import org.gjt.sp.jedit.EditBus;
import org.gjt.sp.jedit.Registers;
import org.gjt.sp.jedit.datatransfer.JEditDataFlavor;
import org.gjt.sp.jedit.datatransfer.JEditTransferableService;
import org.gjt.sp.jedit.datatransfer.TransferHandler;
import org.gjt.sp.jedit.gui.HistoryTextArea;
import org.gjt.sp.jedit.gui.HistoryTextField;
import org.gjt.sp.jedit.msg.EditPaneUpdate;
import org.gjt.sp.jedit.textarea.TextAreaTransferHandler;
import org.gjt.sp.util.Log;

// The boundary marker, never written as a literal: an invisible character in source is
// unreadable, ungreppable, and easy to lose to a stray copy-paste.
phi_wj = new String(Character.toChars(0x2060));

// What counts as one run when folding: the mathematical alphanumeric block, plus the
// two ASCII characters the table's own words use (`size_t`, `w.r.t.`).  A run must hold
// at least one character of the block -- otherwise every full stop and underscore in
// ordinary source would be a run of its own and cost a trip through the interpreter,
// for a decision that can only come back "unchanged".  The block rather than the
// letters the table happens to use is a deliberate widening; WORD_BOUNDARY_PLAN.md,
// "A deliberate widening", says why.  test_word_clipboard.bsh checks that the table
// still uses no ASCII beyond these two.
phi_math_range = "\\x{1D400}-\\x{1D7FF}";
phi_run_class = "[" + phi_math_range + "._]";

/* the generated table: glyph code point <-> the letters it reads as, and the patterns
   that go with it -- they are built here so that a table and its patterns can never
   disagree */

phi_word_table()
{
    // "expand" maps an Integer code point to the String of letters it reads as
    Object phi_tab = new java.util.HashMap();
    phi_tab.put("expand", new java.util.HashMap());
    phi_tab.put("fold", new java.util.HashMap());   // String letters -> String glyph
    phi_tab.put("keys", new java.util.ArrayList());

    String phi_home = System.getenv("PHI_SYSTEM_HOME");
    if (phi_home == null) return phi_tab;
    Object phi_file = new java.io.File(phi_home, "jedit/word-clipboard-text");
    if (!phi_file.isFile()) return phi_tab;

    for (String phi_raw : java.nio.file.Files.readAllLines(phi_file.toPath())) {
        String phi_line = phi_raw.trim();
        if (phi_line.isEmpty() || phi_line.startsWith("#")) continue;
        String[] phi_parts = phi_line.split("\\s+", 2);
        if (phi_parts.length != 2) continue;
        int phi_code = Integer.decode(phi_parts[0]).intValue();
        String phi_letters = phi_parts[1];
        phi_tab.get("expand").put(new Integer(phi_code), phi_letters);
        phi_tab.get("fold").put(phi_letters, new String(Character.toChars(phi_code)));
        phi_tab.get("keys").add(phi_letters);
    }
    // longest first, so that folding a run of adjacent words is unambiguous
    java.util.Collections.sort(phi_tab.get("keys"), new java.util.Comparator() {
        public int compare(a, b) { return b.length() - a.length(); }
    });
    if (phi_tab.get("keys").isEmpty()) return phi_tab;

    // The glyphs themselves.  It is the table's own span rather than the whole private-use
    // area only to keep the scan cheap: what stops a Powerline or Nerd-font character in
    // the buffer from being treated as a word is the lookup in phi_word_expand, which is
    // consulted before anything is emitted, and that also covers a code point retired
    // from the middle of the span by deleting a word from words.txt.
    int phi_lo = 0x10FFFF;
    int phi_hi = 0;
    for (Integer phi_cp : phi_tab.get("expand").keySet()) {
        if (phi_cp.intValue() < phi_lo) phi_lo = phi_cp.intValue();
        if (phi_cp.intValue() > phi_hi) phi_hi = phi_cp.intValue();
    }
    phi_tab.put("glyph_pat", Pattern.compile("[\\x{" + Integer.toHexString(phi_lo) + "}-\\x{"
                                             + Integer.toHexString(phi_hi) + "}]"));

    // a maximal run of run-forming characters holding at least one mathematical letter
    phi_tab.put("run_pat", Pattern.compile(phi_run_class + "*[" + phi_math_range + "]"
                                           + phi_run_class + "*"));

    // all the words as one alternation.  Java tries alternatives in order, and the list
    // is longest first, so the first one that matches at a position is the longest --
    // which is exactly the greedy rule this replaced.
    StringBuffer phi_alt = new StringBuffer();
    for (String phi_key : phi_tab.get("keys")) {
        if (phi_alt.length() > 0) phi_alt.append("|");
        phi_alt.append(Pattern.quote(phi_key));
    }
    phi_tab.put("word_pat", Pattern.compile(phi_alt.toString()));
    return phi_tab;
}

phi_t = phi_word_table();

/* leaving jEdit: glyph -> letters, with a joiner between two adjacent glyphs */

phi_word_expand(t, text)
{
    if (text == null) return text;
    Object phi_pat = t.get("glyph_pat");
    if (phi_pat == null) return text;
    Object phi_expand = t.get("expand");
    Matcher phi_m = phi_pat.matcher(text);
    StringBuffer phi_out = new StringBuffer(text.length());
    int phi_prev = -1;                      // where the previous *word* ended
    int phi_last = 0;                       // how far the text has been copied out
    while (phi_m.find()) {
        phi_out.append(text, phi_last, phi_m.start());
        phi_last = phi_m.end();
        // The class spans the table's code points; a retired one inside that span is
        // not a word, so look the word up first and mark a boundary only beside one.
        String phi_letters = phi_expand.get(new Integer(text.codePointAt(phi_m.start())));
        if (phi_letters == null) {
            phi_out.append(text, phi_m.start(), phi_m.end());
            continue;
        }
        // the previous character of the source was a word glyph too: mark the boundary
        if (phi_m.start() == phi_prev) phi_out.append(phi_wj);
        phi_out.append(phi_letters);
        phi_prev = phi_m.end();
    }
    phi_out.append(text, phi_last, text.length());
    return phi_out.toString();
}

/* entering jEdit: letters -> glyph, but only where a whole run of letters is words */

phi_word_fold_run(t, run)
{
    Object phi_fold = t.get("fold");
    Matcher phi_m = t.get("word_pat").matcher(run);
    StringBuffer phi_buf = new StringBuffer(run.length());
    int phi_pos = 0;
    while (phi_m.find(phi_pos)) {
        // A word may be written against punctuation the table itself uses -- a full
        // stop after it, an underscore between two words -- so ASCII that no word
        // claims is carried over.  Any other ASCII never reaches here; it ends the
        // run.  A mathematical letter that no word claims is different: the run is
        // then somebody else's bold text, and none of it may be touched.
        for (int phi_i = phi_pos; phi_i < phi_m.start(); phi_i++)
            if (run.charAt(phi_i) > 127) return run;
        phi_buf.append(run, phi_pos, phi_m.start());
        phi_buf.append(phi_fold.get(phi_m.group()));
        phi_pos = phi_m.end();
    }
    for (int phi_i = phi_pos; phi_i < run.length(); phi_i++)  // the tail after the last word
        if (run.charAt(phi_i) > 127) return run;
    phi_buf.append(run, phi_pos, run.length());
    return phi_buf.toString();
}

phi_word_fold(t, text)
{
    if (text == null) return text;
    Object phi_pat = t.get("run_pat");
    if (phi_pat == null) return text;
    Matcher phi_m = phi_pat.matcher(text);
    StringBuffer phi_out = new StringBuffer(text.length());
    while (phi_m.find())
        phi_m.appendReplacement(
            phi_out, Matcher.quoteReplacement(phi_word_fold_run(t, phi_m.group())));
    phi_m.appendTail(phi_out);
    // every joiner goes, wherever it came from: it has no use in Isabelle source, and a
    // conditional strip would leave one behind whenever neither neighbour folded
    return phi_out.toString().replace(phi_wj, "");
}

/* pasting into jEdit's own text input fields */

// Everything the clipboard route needs is public on javax.swing.TransferHandler, so the
// wrapper holds the field's original handler and calls it.  Only the incoming text is
// rewritten; canImport, the source actions and both export routes go straight through.
//
// Two things it deliberately does not do.  It does not override
// importData(TransferSupport): the inherited one forwards here, but the handler being
// wrapped overrides that method to record isDrop and friends, so on a *drop* into a field
// the inner body sees isDrop == false -- no focus request, the dropped text not selected.
// Paste is unaffected.  And it does not expand on the way out, so copying out of a wrapped
// field yields the raw glyph; ../fonts/WORD_GLYPHS.md says so rather than leaving it to be
// discovered.
phi_field_handler(phi_inner)
{
    // An anonymous subclass rather than a scripted class, for two measured reasons: bsh
    // cannot find a scripted constructor whose parameter has no declared type, and the
    // anonymous subclass it generates has only a no-arg constructor -- it does not forward
    // arguments, so the superclass's protected no-arg form is the one to call.  Every
    // method below returns a primitive or void, which is the shape bsh's anonymous-class
    // parser handles.  One wrapper per field, closing over that field's own inner handler.
    Object phi_handler = new javax.swing.TransferHandler() {
        public boolean canImport(javax.swing.JComponent c, DataFlavor[] f) {
            return phi_inner.canImport(c, f);
        }
        public boolean canImport(javax.swing.TransferHandler.TransferSupport s) {
            return phi_inner.canImport(s);
        }
        public int getSourceActions(javax.swing.JComponent c) {
            return phi_inner.getSourceActions(c);
        }
        public void exportToClipboard(javax.swing.JComponent c, Clipboard cb, int a) {
            phi_inner.exportToClipboard(c, cb, a);
        }
        public void exportAsDrag(javax.swing.JComponent c, java.awt.event.InputEvent e,
                                 int a) {
            phi_inner.exportAsDrag(c, e, a);
        }
        public boolean importData(javax.swing.JComponent c, Transferable t) {
            try {
                // anything copied inside jEdit carries the glyphs themselves under jEdit's
                // own flavor: take that, and the fold rule never enters into it, so even
                // the shapes folding cannot repair arrive exact
                Object phi_rich_flavor = JEditDataFlavor.jEditRichTextDataFlavor;
                if (t != null && t.isDataFlavorSupported(phi_rich_flavor)) {
                    Object phi_rich = t.getTransferData(phi_rich_flavor);
                    if (phi_rich != null)
                        return phi_inner.importData(
                            c, new StringSelection(phi_rich.getText()));
                }
                if (t != null && t.isDataFlavorSupported(DataFlavor.stringFlavor)) {
                    String phi_plain = t.getTransferData(DataFlavor.stringFlavor);
                    if (phi_plain != null) {
                        String phi_folded = phi_word_fold(phi_t, phi_plain);
                        if (!phi_folded.equals(phi_plain))
                            return phi_inner.importData(c, new StringSelection(phi_folded));
                    }
                }
            }
            catch (Exception e) { }
            return phi_inner.importData(c, t);
        }
    };
    return phi_handler;
}

phi_wrap_field(phi_field)
{
    if (phi_field == null) return false;
    // idempotent, and by a mark on the component rather than by the wrapper's type: jEdit
    // resets the BeanShell class manager when a plugin is unloaded, after which a fresh
    // class object would make an instanceof test say "not ours" and wrap a second time
    if (phi_field.getClientProperty("phi_word_wrapped") != null) return false;
    Object phi_inner = phi_field.getTransferHandler();
    if (phi_inner == null) return false;
    phi_field.setTransferHandler(phi_field_handler(phi_inner));
    phi_field.putClientProperty("phi_word_wrapped", Boolean.TRUE);
    return true;
}

phi_field_font(phi_field)
{
    // A Swing text component has one font for the whole component, so a field showing a
    // word glyph and ordinary text at once needs a family that draws both.  PhiSymbols
    // is that family: fonts/build_word_glyphs.py merges Isabelle's own text face into
    // it.  Kept apart from phi_wrap_field, which returns early for a field it wrapped on
    // an earlier pass -- neither of its conditions says anything about the font.
    if (phi_field == null) return false;
    java.awt.Font phi_was = phi_field.getFont();
    if (phi_was == null || "PhiSymbols".equals(phi_was.getFamily())) return false;
    java.awt.Font phi_new =
        new java.awt.Font("PhiSymbols", phi_was.getStyle(), phi_was.getSize());
    // The family may not resolve -- the font was never registered, or a re-export gave
    // it another name ID 1.  Java answers with family Dialog rather than failing, and
    // installing that would replace the field's FontUIResource with a plain Font that
    // draws notdef boxes.  Checking here, rather than trusting the latch above, is what
    // makes "a field never carries a font that does not resolve" true by construction;
    // and because it is decided per field rather than once, a field built before
    // registration recovers as soon as the next one is built.
    if (!"PhiSymbols".equals(phi_new.getFamily())) return false;
    phi_field.setFont(phi_new);
    return true;
}

phi_install_field_paste()
{
    // The fields are built lazily, inside dialogs jEdit constructs on demand, and no
    // message announces them.  This listener runs on every container event in the
    // application, so its body stays as small as it can be: a type test, and the two
    // things a field needs -- a transfer handler that folds, and a font that draws.
    Object phi_awt_listener = new java.awt.event.AWTEventListener() {
        public void eventDispatched(java.awt.AWTEvent e) {
            try {
                if (e.getID() != java.awt.event.ContainerEvent.COMPONENT_ADDED) return;
                Object phi_child = e.getChild();
                if (phi_child instanceof HistoryTextArea
                        || phi_child instanceof HistoryTextField) {
                    phi_wrap_field(phi_child);
                    phi_field_font(phi_child);
                }
            }
            catch (Throwable ex) { }
        }
    };
    java.awt.Toolkit.getDefaultToolkit().addAWTEventListener(
        phi_awt_listener, java.awt.AWTEvent.CONTAINER_EVENT_MASK);
}

/* the X11 primary selection */

phi_install_primary_selection()
{
    // jEdit maps the primary selection to register '%' (Registers.java:610-612), and its
    // two writers -- a mouse selection and a gutter line selection -- both go through
    // Registers.setRegister(char,String), which builds a bare StringSelection and never
    // consults the service list the copy direction hooks.  Neither is gated by the
    // middle-click preference, and Isabelle's site properties turn that preference on
    // anyway, so this is the default path: the wrapper does both halves itself.
    Object phi_primary = Registers.getRegister('%');
    if (phi_primary == null) return;            // no primary selection on this platform

    // The last text this wrapper published, and the text it was made from.  Expanding and
    // folding are not inverses for every input -- a glyph written against somebody else's
    // bold letters expands and does not fold back -- so jEdit reading its own selection
    // back is answered from here instead.  One map per wrapper rather than one at the top
    // level: installing twice would otherwise have the outer wrapper store into the map
    // the inner one reads, and a selected glyph would read back as letters.
    Object phi_memo = new java.util.HashMap();

    Object phi_selection = new Registers.Register() {
        // Nothing in the shipped configuration reads this: the register viewer skips '%'
        // before asking, the register saver short-circuits on it, and getRegisterValue has
        // no caller.  ClipboardRegister.toString answers null for a selection holding no
        // text, which is its business and not this wrapper's.
        public String toString() { return phi_primary.toString(); }

        public void setValue(String value) {
            this.setTransferable(new StringSelection(value));
        }

        public void setTransferable(Transferable t2) {
            try {
                if (t2 != null && t2.isDataFlavorSupported(DataFlavor.stringFlavor)) {
                    String phi_original = t2.getTransferData(DataFlavor.stringFlavor);
                    if (phi_original != null) {
                        String phi_expanded = phi_word_expand(phi_t, phi_original);
                        phi_memo.put("original", phi_original);
                        phi_memo.put("expanded", phi_expanded);
                        phi_primary.setTransferable(new StringSelection(phi_expanded));
                        return;
                    }
                }
                // inside the try, not after it: written after, a selection that throws
                // would be caught here and then written again unguarded, and the second
                // throw would escape onto the AWT event thread
                phi_primary.setTransferable(t2);
            }
            catch (Exception e) { }
        }

        public Transferable getTransferable() {
            // bound before the try, because the catch returns it: if the very first
            // statement is what throws, an unbound name would make the catch fail too
            Transferable phi_outer = null;
            try {
                phi_outer = phi_primary.getTransferable();
                if (phi_outer == null) return phi_outer;
                if (!phi_outer.isDataFlavorSupported(DataFlavor.stringFlavor))
                    return phi_outer;
                String phi_now = phi_outer.getTransferData(DataFlavor.stringFlavor);
                if (phi_now == null) return phi_outer;
                // exactly what this wrapper last published: hand back the text it was made
                // from, so a round trip inside jEdit is exact even for the shapes folding
                // cannot repair.  Another application publishing that string character for
                // character is answered the same way; test_word_clipboard.bsh pins it.
                String phi_sent = phi_memo.get("expanded");
                if (phi_sent != null && phi_sent.equals(phi_now))
                    return new StringSelection(phi_memo.get("original"));
                return new StringSelection(phi_word_fold(phi_t, phi_now));
            }
            // the transferable already in hand, not a second phi_primary.getTransferable():
            // that would cost another blocking fetch from the selection's owner
            catch (Exception e) { return phi_outer; }
        }
    };
    Registers.setRegister('%', phi_selection);
}

/* drag and drop in buffer text areas */

// Drag reaches neither of the hooks above.  TextAreaTransferHandler.createTransferable
// returns a bare StringSelection over the selected text, and importData and exportDone read
// the plain text straight back, so no service list and no register is ever consulted.  The
// handler itself is therefore subclassed and installed on every buffer text area.
//
// The two slots below are what makes a drag that stays inside jEdit exact.  Expanding and
// folding are not inverses for every input -- a glyph written against somebody else's bold
// letters, or two glyphs bridged by an underscore, expand and do not fold back -- and a move
// drag deletes the source text before re-inserting it, so an inexact round trip would not
// merely fail to restore a glyph, it would rewrite the buffer.  When the string coming back
// is character for character the one createTransferable handed out, the text it was made
// from is put back instead of folding.
//
// One map at the top level rather than one per handler, which is the opposite of what the
// primary-selection wrapper needs: a drag started in one EditPane is finished by the other
// pane's handler instance -- importData runs on the destination's and exportDone on the
// source's -- so the state has to be shared across instances, exactly as
// TextAreaTransferHandler shares its own dragSource in a private static.  Installing twice
// replaces the handler rather than nesting one inside another, so nothing reads a map that
// something else writes.
phi_drag = new java.util.HashMap();     // slots "original" and "expanded"

// A transferable that is another one with its plain text replaced.  Delegating rather than a
// fresh StringSelection because replacing the transferable would strip every other flavor,
// and importData dispatches on those -- a file dropped from a file manager among them --
// before it ever looks at text.  Bound to a name for the reason the comment above
// phi_service gives: all three methods return reference types.
phi_delegating(phi_inner, phi_replacement)
{
    Object phi_w = new Transferable() {
        public DataFlavor[] getTransferDataFlavors() {
            return phi_inner.getTransferDataFlavors();
        }
        public boolean isDataFlavorSupported(DataFlavor phi_f) {
            return phi_inner.isDataFlavorSupported(phi_f);
        }
        public Object getTransferData(DataFlavor phi_f) {
            if (DataFlavor.stringFlavor.equals(phi_f)) return phi_replacement;
            return phi_inner.getTransferData(phi_f);
        }
    };
    return phi_w;
}

// what arrives on a drop: the remembered text if we produced this string, folded otherwise
phi_unexpand(phi_in)
{
    try {
        if (phi_in == null) return phi_in;

        // jEdit dispatches on these two before it looks at text at all, and a file dragged
        // in from a file manager must still open.  Returning before touching stringFlavor is
        // the point: fetching it here would force a blocking cross-process transfer jEdit
        // would never have asked for, on the AWT thread, for a string then thrown away.
        if (phi_in.isDataFlavorSupported(DataFlavor.javaFileListFlavor)) return phi_in;
        for (DataFlavor phi_fl : phi_in.getTransferDataFlavors()) {   // jEdit's own uri-list
            if ("text".equals(phi_fl.getPrimaryType())                // test, which is private
                    && "uri-list".equals(phi_fl.getSubType())
                    && phi_fl.getRepresentationClass() == String.class)
                return phi_in;
        }

        if (!phi_in.isDataFlavorSupported(DataFlavor.stringFlavor)) return phi_in;
        String phi_s = phi_in.getTransferData(DataFlavor.stringFlavor);
        if (phi_s == null) return phi_in;                             // legal, if unusual

        String phi_out;
        String phi_sent = phi_drag.get("expanded");
        if (phi_sent != null && phi_sent.equals(phi_s)) phi_out = phi_drag.get("original");
        else phi_out = phi_word_fold(phi_t, phi_s);                   // not a drag we started
        if (phi_out == null) phi_out = phi_s;

        // A wrapper even when nothing changed: the string has been paid for already, and
        // handing back phi_in would make importText fetch it a second time -- on X11 a
        // second blocking selection transfer on the AWT thread, on the commonest path there
        // is, any ordinary text drop.
        return phi_delegating(phi_in, phi_out);
    }
    // getTransferData declares UnsupportedFlavorException and IOException, and on X11 an
    // IOException from a foreign drag source is routine.  Uncaught, one leaves jEdit's
    // compound edit open and its dragSource non-null where the stock handler leaves both
    // clean.  This does not make the overrides total, which is why each guards itself too.
    catch (Exception e) { return phi_in; }
}

class Phi_Text_Area_Transfer_Handler extends TextAreaTransferHandler {

    // public, where the superclass declares these protected.  bsh resolves super.<method> by
    // a public-method lookup on the superclass and cannot fall back on accessibility --
    // Capabilities.setAccessibility throws Unavailable unconditionally -- so protected here
    // installs cleanly and then fails at the first drag.  Java permits the widening and the
    // JVM still dispatches to the override.
    public Transferable createTransferable(javax.swing.JComponent phi_c) {
        phi_drag.clear();          // a drag that skipped exportDone may have left slots
        // super first: it is where the superclass sets its own dragSource, and every branch
        // of importText and exportDone keys off that
        Transferable phi_base = super.createTransferable(phi_c);
        if (phi_base == null) return null;
        try {
            String phi_original = phi_base.getTransferData(DataFlavor.stringFlavor);
            if (phi_original != null) {
                String phi_expanded = phi_word_expand(phi_t, phi_original);
                phi_drag.put("original", phi_original);
                phi_drag.put("expanded", phi_expanded);
                return new StringSelection(phi_expanded);
            }
        }
        catch (Exception e) { }
        // jEdit's own transferable: the drag carries the glyphs themselves, degraded but
        // never wrong, and the slots stay empty so no later match can fire against them
        return phi_base;
    }

    // Each override carries its own guard, and it is not belt and braces: super can throw,
    // and bsh re-types whatever comes out as TargetError, which is a *checked* exception,
    // while the JDK's drop path catches only RuntimeException and its dragDropEnd path --
    // the one that calls exportDone -- catches nothing at all.
    public boolean importData(javax.swing.JComponent phi_c, Transferable phi_tr) {
        try { return super.importData(phi_c, phi_unexpand(phi_tr)); }
        catch (Exception e) { Log.log(Log.ERROR, this, e); return false; }
    }

    // exportDone needs the folding too: its same-text-area branch re-inserts from
    // stringFlavor, so without it a drag within one pane would deposit letters.
    public void exportDone(javax.swing.JComponent phi_c, Transferable phi_tr, int phi_action) {
        try { super.exportDone(phi_c, phi_unexpand(phi_tr), phi_action); }
        catch (Exception e) { Log.log(Log.ERROR, this, e); }
        // both ends clear the slots, because either end can be skipped: exportToClipboard
        // reaches exportDone only on success, and jEdit returns early from it whenever the
        // drag ended in no action at all
        finally { phi_drag.clear(); }
    }
}

phi_install_drag()
{
    // Only the buffer text area has a transfer handler at all -- EditPane installs one and
    // that is the sole such call on a text area -- and every EditPane is built in
    // View.createEditPane, Isabelle's editpane-factory consulted inside it, so catching them
    // as they are created off the EditBus catches all of them.  The bus delivers on the AWT
    // thread, which is where setTransferHandler belongs, and startup scripts run before the
    // first view exists, so none is missed.
    Object phi_bus_listener = new EBComponent() {
        public void handleMessage(EBMessage phi_msg) {
            // The guard protects other people's subscribers, not this code: an EBComponent
            // is registered under EBMessage.class and so sees every message, and EditBus
            // wraps its whole handler loop in one try -- one throw and every handler behind
            // us receives nothing.  jEdit's own DockingLayoutManager and Isabelle's symbols
            // dockable are behind us.
            try {
                // CREATED is declared Object, so its identity is not part of the contract
                if (phi_msg instanceof EditPaneUpdate
                        && EditPaneUpdate.CREATED.equals(phi_msg.getWhat()))
                    phi_msg.getEditPane().getTextArea()
                           .setTransferHandler(new Phi_Text_Area_Transfer_Handler());
            }
            catch (Exception e) { Log.log(Log.ERROR, this, e); }
        }
    };
    EditBus.addToBus(phi_bus_listener);
}

/* installation */

phi_word_install()
{
    int phi_n = phi_t.get("expand").size();
    if (phi_n == 0) {
        Log.log(Log.WARNING, this, "phi word clipboard: no table found, not installed");
        return;
    }

    // An anonymous class body written directly as an argument parses only when every
    // method in it returns a primitive type; one declaring a reference return type
    // fails with `Parse error ... Encountered: (`.  Both of these declare reference
    // return types, so both are bound to a name first.
    Object phi_service = new JEditTransferableService() {
        public boolean accept(textArea, text) { return true; }
        public Transferable getTransferable(textArea, text) {
            return new StringSelection(phi_word_expand(phi_t, text));
        }
    };
    TransferHandler.getInstance().registerTransferableService(phi_service);

    Object phi_clipboard = Registers.getRegister('$');
    Object phi_wrapper = new Registers.Register() {
        public String toString() { return phi_clipboard.toString(); }
        public void setValue(String value) { phi_clipboard.setValue(value); }
        public void setTransferable(Transferable t2) { phi_clipboard.setTransferable(t2); }
        public Transferable getTransferable() {
            Object phi_outer = phi_clipboard.getTransferable();
            if (phi_outer == null) return null;
            // text jEdit itself put there: it still carries the glyphs, take it as is
            if (phi_outer.isDataFlavorSupported(JEditDataFlavor.jEditRichTextDataFlavor))
                return phi_outer;
            if (!phi_outer.isDataFlavorSupported(DataFlavor.stringFlavor)) return phi_outer;
            try {
                String phi_text = phi_outer.getTransferData(DataFlavor.stringFlavor);
                return new StringSelection(phi_word_fold(phi_t, phi_text));
            }
            catch (Exception e) { return phi_outer; }
        }
    };
    Registers.setRegister('$', phi_wrapper);

    phi_install_field_paste();
    phi_install_primary_selection();
    phi_install_drag();

    Log.log(Log.NOTICE, this,
            "phi word clipboard: " + phi_n + " words expand on copy, fold on paste");
}

phi_word_install();
