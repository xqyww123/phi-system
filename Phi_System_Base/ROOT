  Phi_Statespace fork of StateFun/DistinctTreeProver) must stay editable and hence
  outside this image.*)
session Phi_System_Base = "HOL-Library" +
  sessions
    "HOL-Computational_Algebra"
    "HOL-Eisbach"
    "List-Index"
    "Word_Lib"
    "Minilang_AoA"
  theories
    "HOL-Computational_Algebra.Primes"
    "HOL-Eisbach.Eisbach"
    "HOL-Eisbach.Eisbach_Tools"
    "List-Index.List_Index"
    "Word_Lib.More_Word"
    "Word_Lib.Signed_Division_Word"
    "Word_Lib.Word_Lemmas"
    "Minilang_AoA.Minilang_AoA"
